IMAGE_REF=registry.example.com/group/zk-memory:replace-with-commit-sha

API_PORT=8000
APP_DATA_DIR=./data

POSTGRES_USER=memory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=memory
POSTGRES_DATA_DIR=./postgres_data

QDRANT_DATA_DIR=./qdrant_storage
QDRANT_COLLECTION=notes_embeddings
QDRANT_API_KEY=

OLLAMA_HOST=https://ollama.example.internal
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_TASK_PREFIX=true

BUFFER_RETENTION_DAYS=7
NOTE_MAX_CONTENT_LENGTH=2048
LOG_LEVEL=INFO
LOG_FORMAT=json

CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

MEMORY_API_KEY_READ=
MEMORY_API_KEY_BUFFER=
MEMORY_API_KEY_WRITE=
MEMORY_API_KEY_DUMP=
MEMORY_API_KEY_ADMIN=
