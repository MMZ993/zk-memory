# Application
APP_NAME=AI Agent Memory System
APP_VERSION=1.0.0
DEBUG=False

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database backend: "sqlite" (default, dev/home lab) | "postgres" (production)
# Must match the DATABASE_URL scheme.
DB_BACKEND=sqlite
DATABASE_URL=sqlite:///./data/memory.db

# PostgreSQL (use with docker-compose.postgres.yml):
# DB_BACKEND=postgres
# DATABASE_URL=postgresql+psycopg://memory:memory@postgres:5432/memory

# Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=notes_embeddings
QDRANT_API_KEY=

# Embeddings Provider: local Ollama (default)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
OLLAMA_HOST=http://localhost:11434

# Optional legacy provider: OpenAI
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
# OPENAI_API_KEY=

# Task-instructed embedding prefix (nomic-embed-text, mxbai-embed-large)
# Prepends "search_document:" when indexing notes and "search_query:" when searching.
# Significantly improves retrieval quality with supported models.
# WARNING: enabling this after notes are already indexed requires a full re-embed
# (use the admin re-embed API endpoint). Default: false (safe for existing deployments).
# Recommended: true for fresh deployments.
EMBEDDING_TASK_PREFIX=false

# Maximum note content length in characters. 0 = unlimited.
# Notes over this limit are rejected with HTTP 422.
NOTE_MAX_CONTENT_LENGTH=2048

# API Authentication — scoped keys (see docs/api-scopes.md)
# Leave all empty to disable auth (dev/local mode).
# Each value accepts a single key or comma-separated list of keys.
# Admin key passes every scope check; the others are flat and independent.
#
# Generate a key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MEMORY_API_KEY_READ=
MEMORY_API_KEY_BUFFER=
MEMORY_API_KEY_WRITE=
MEMORY_API_KEY_DUMP=
MEMORY_API_KEY_ADMIN=

# Buffer Notes
BUFFER_RETENTION_DAYS=7

# Markdown Export (export triggered via bash scripts or API, not auto)
MARKDOWN_DIR=./data/notes

# Performance
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF=40
INDEXING_THRESHOLD=20000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
